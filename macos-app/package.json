{
  "name": "chanakya-trade",
  "productName": "ChanakyaTrade",
  "version": "0.2.0",
  "description": "ChanakyaTrade — AI-Powered Strategic Quant Terminal & Multi-Agent Intelligence for Indian Markets",
  "author": "ChanakyaTrade Team",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:renderer": "electron-vite dev --rendererOnly",
    "prebuild": "cd .. && python3 -m build --wheel -o macos-app/dist",
    "build": "electron-vite build && electron-builder --mac",
    "preview": "electron-vite preview",
    "lint:hooks": "node scripts/audit-react-hooks.js",
    "lint:biome": "biome lint src --diagnostic-level=error",
    "format": "biome format --write src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit",
    "build:web": "node scripts/audit-react-hooks.js && electron-vite build && node scripts/build-web.js"
  },
  "dependencies": {
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.45.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.8",
    "@babel/traverse": "^7.29.8",
    "@biomejs/biome": "^2.5.13",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "^5.0.0",
    "autoprefixer": "^10.6.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.16.1",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "browserslist": ">=4.28.8",
    "postcss-selector-parser": ">=7.1.0"
  },
  "build": {
    "appId": "ai.chanakya.trade",
    "productName": "ChanakyaTrade",
    "files": [
      "out/**/*",
      "build/icon.icns"
    ],
    "extraResources": [
      {
        "from": "dist/",
        "to": "python-pkg/",
        "filter": [
          "*.whl"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.finance",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    }
  }
}
