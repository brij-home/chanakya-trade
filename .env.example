# ==============================================================================
#  INDIA TRADE CLI - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# ==============================================================================
# 1. AI PROVIDER & DUAL-LLM ROUTING SETTINGS
# ==============================================================================
# Set AI_PROVIDER to one of:
#   gemini      - Google Gemini (Google AI Studio)
#   nvidia      - NVIDIA NIM (build.nvidia.com)
#   anthropic   - Anthropic Claude
#   openai      - OpenAI GPT / Reasoning
#   groq        - Groq Ultra-fast inference
#   deepseek    - DeepSeek Official API
#   openrouter  - OpenRouter Multi-model gateway
#   ollama      - Local offline models
# ------------------------------------------------------------------------------

# Primary / Default AI Provider
AI_PROVIDER=gemini
AI_MODEL=gemini-3.7-flash

# Fast Extraction Layer (Runs parallel analysis for Technicals, Fundamentals, News, Sentiment)
AI_FAST_PROVIDER=gemini
AI_FAST_MODEL=gemini-3.7-flash

# Deep Reasoning Layer (Powers Bull vs Bear Debate, Risk Gate & Fund Manager Synthesis)
AI_DEEP_PROVIDER=gemini
AI_DEEP_MODEL=gemini-3.7-flash


# ==============================================================================
# 2. AI PROVIDER PRESETS & CREDENTIALS
# ==============================================================================

# ── [A] Google Gemini (Google AI Studio) ──────────────────────────────────────
# Free API Key: https://aistudio.google.com/
# Recommended Models: gemini-3.7-flash (Latest & Fast), gemini-3.5-flash-lite (High Quota & Lightweight)
# TIP: Supply multiple comma-separated keys (e.g. key1,key2,key3) for automatic round-robin & rate-limit failover!
GEMINI_API_KEY=your_gemini_api_key_1,your_gemini_api_key_2
GEMINI_MODEL=gemini-3.7-flash

# ── [B] NVIDIA NIM (build.nvidia.com) ─────────────────────────────────────────
# API Key: https://build.nvidia.com/
# Active Models: meta/llama-3.2-11b-vision-instruct, meta/llama-3.2-90b-vision-instruct, deepseek-ai/deepseek-v4-flash-0731
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# ── [C] Anthropic Claude ──────────────────────────────────────────────────────
# API Key: https://console.anthropic.com/
# Latest Models: claude-3-7-sonnet (Hybrid Reasoning), claude-3-5-sonnet, claude-3-5-haiku
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet

# ── [D] OpenAI GPT & Reasoning ────────────────────────────────────────────────
# API Key: https://platform.openai.com/
# Latest Models: gpt-4.5-preview, gpt-4o, o3-mini, o1, gpt-4o-mini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── [E] Groq (Ultra-Fast Cloud Inference) ─────────────────────────────────────
# API Key: https://console.groq.com/
# Latest Models: llama-3.3-70b-versatile, deepseek-r1-distill-llama-70b, qwen-2.5-32b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── [F] OpenRouter (Unified Model Gateway) ────────────────────────────────────
# API Key: https://openrouter.ai/
# Latest Models: anthropic/claude-3.7-sonnet, deepseek/deepseek-r1, meta-llama/llama-3.3-70b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.7-sonnet

# ── [G] DeepSeek Official API ─────────────────────────────────────────────────
# API Key: https://platform.deepseek.com/
# Latest Models: deepseek-chat (V3), deepseek-reasoner (R1 Reasoning)
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ── [H] Ollama (Local Offline Models) ─────────────────────────────────────────
# Run locally: ollama pull llama3.3 && ollama pull deepseek-r1
# Models: llama3.3, deepseek-r1, qwen2.5
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.3


# ==============================================================================
# 3. TRADING MODE & RISK MANAGEMENT
# ==============================================================================
# Trading mode: PAPER or LIVE
TRADING_MODE=PAPER

# Default maximum risk per trade as % of total capital (e.g. 2 = 2%)
DEFAULT_RISK_PCT=2

# Total trading capital in INR
TOTAL_CAPITAL=200000


# ==============================================================================
# 4. BROKER INTEGRATIONS (Configure on need basis)
# ==============================================================================
# Zerodha Kite Connect (https://developers.kite.trade/)
KITE_API_KEY=
KITE_API_SECRET=

# Groww Partner API
GROWW_CLIENT_ID=
GROWW_CLIENT_SECRET=
GROWW_REDIRECT_URL=http://localhost:8765/groww/callback

# Fyers API (https://myapi.fyers.in)
FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URL=http://127.0.0.1:8765/fyers/callback

# Angel One SmartAPI (https://smartapi.angelbroking.com/)
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# Upstox API (https://upstox.com/developer/api-documentation/)
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URL=http://127.0.0.1:8765/upstox/callback

# Stoxkart API (SMC Global Securities — Free API)
STOXKART_API_KEY=
STOXKART_API_SECRET=
STOXKART_CLIENT_CODE=
STOXKART_PASSWORD=
STOXKART_TOTP_SECRET=


# ==============================================================================
# 5. OPTIONAL NOTIFICATIONS & NEWS DATA
# ==============================================================================
# NewsAPI (https://newsapi.org/)
NEWSAPI_ENABLED=0
NEWSAPI_KEY=

# Telegram Bot Alerts (@BotFather on Telegram)
TELEGRAM_BOT_TOKEN=


# ==============================================================================
# 6. WEB SEARCH PROVIDERS (AI Real-time Research & Catalysts)
# ==============================================================================
# Tavily AI Research Search (https://tavily.com - 1,000 free searches/mo)
TAVILY_API_KEY=

# Exa Neural Search (https://exa.ai - 1,000 free searches/mo)
EXA_API_KEY=

# Perplexity Search (https://www.perplexity.ai/)
PERPLEXITY_API_KEY=
