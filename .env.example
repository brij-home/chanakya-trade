# ==============================================================================
#  INDIA TRADE CLI - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# ==============================================================================
# 1. AI PROVIDER & DUAL-LLM ROUTING SETTINGS
# ==============================================================================
# Set AI_PROVIDER to one of:
#   gemini      - Google Gemini (Google AI Studio)
#   nvidia      - NVIDIA NIM (build.nvidia.com)
#   anthropic   - Anthropic Claude
#   openai      - OpenAI GPT / Reasoning
#   groq        - Groq Ultra-fast inference
#   deepseek    - DeepSeek Official API
#   openrouter  - OpenRouter Multi-model gateway
#   ollama      - Local offline models
# ------------------------------------------------------------------------------

# Primary / Default AI Provider
AI_PROVIDER=gemini
AI_MODEL=gemini-3.8-flash

# Fast Extraction Layer (Runs parallel analysis for Technicals, Fundamentals, News, Sentiment)
AI_FAST_PROVIDER=gemini
AI_FAST_MODEL=gemini-3.8-flash

# Deep Reasoning Layer (Powers Bull vs Bear Debate, Risk Gate & Fund Manager Synthesis)
AI_DEEP_PROVIDER=gemini
AI_DEEP_MODEL=gemini-3.8-flash


# ==============================================================================
# 2. AI PROVIDER PRESETS & CREDENTIALS
# ==============================================================================

# ── [A] Google Gemini (Google AI Studio) ──────────────────────────────────────
# Free API Key: https://aistudio.google.com/
# Active Models: gemini-3.8-flash (First Priority Fast), gemini-3.7-flash, gemini-3.5-flash-lite (High quota & speed)
# TIP: Supply multiple comma-separated keys (key1,key2,key3) for automatic round-robin & 45s cooldown failover!
GEMINI_API_KEY=your_gemini_api_key_1,your_gemini_api_key_2
GEMINI_MODEL=gemini-3.8-flash

# ── [B] Groq (Ultra-Fast Cloud Inference — 500+ tok/s) ────────────────────────
# Free API Key: https://console.groq.com/
# Active Models: llama-3.3-70b-versatile, qwen-2.5-32b, deepseek-r1-distill-llama-70b
# TIP: Supply multiple comma-separated keys for pooled RPM/TPM throughput!
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=your_groq_api_key_1,your_groq_api_key_2
GROQ_MODEL=llama-3.3-70b-versatile

# ── [C] DeepSeek Official API (High Quality Reasoning & Low Cost) ─────────────
# API Key: https://platform.deepseek.com/
# Active Models: deepseek-chat (V3), deepseek-reasoner (R1 Reasoning)
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ── [D] NVIDIA NIM (build.nvidia.com) ─────────────────────────────────────────
# Free Credits API Key: https://build.nvidia.com/
# Active Models: meta/llama-3.2-11b-vision-instruct, meta/llama-3.2-90b-vision-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# ── [E] OpenRouter (Unified Model Gateway & Free Tier) ────────────────────────
# Portal: https://openrouter.ai/
# Free models: meta-llama/llama-3.3-70b-instruct:free, qwen/qwen-2.5-72b-instruct:free
# Limitations: Free tier rate limits vary based on daily community traffic.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# ── [F] Cerebras Cloud (World's Fastest Inference: 1,800+ tok/s) ──────────────
# Portal: https://cloud.cerebras.ai/ (Generous Free Developer Tier)
# Active Models: llama-3.3-70b, llama-3.1-8b
# Limitations: Max 8k-32k context on free tier; strict 30 RPM limit per key.
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# ── [G] SambaNova Cloud (Full-Precision 16-bit 671B DeepSeek-R1 & Llama 70B) ──
# Portal: https://cloud.sambanova.ai/ (Free Developer API Key on signup)
# Active Models: Meta-Llama-3.3-70B-Instruct, DeepSeek-R1, Qwen2.5-72B-Instruct
# Limitations: Strict 20-30 RPM rate limit on free tier; DeepSeek-R1 responses take 5-15s due to test-time compute.
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct

# ── [H] GitHub Models (100% Free GPT-4o & Llama via GitHub PAT Token) ─────────
# Portal: https://github.com/marketplace/models (Sign in with your GitHub account)
# Token: Create a standard personal access token at https://github.com/settings/tokens
# Active Models: gpt-4o, gpt-4o-mini, o3-mini, Meta-Llama-3.3-70B-Instruct
# Limitations: Daily rate limits (150 requests/day for GPT-4o, 15 RPM). Not for high-frequency loop scanning.
GITHUB_BASE_URL=https://models.inference.ai.azure.com
GITHUB_TOKEN=
GITHUB_MODEL=gpt-4o

# ── [I] DeepInfra (Deep Discount Serverless Host) ──────────────────────────────
# Portal: https://deepinfra.com/ (Free signup credits; DeepSeek V3/R1 at ~$0.20–$0.50/M tokens)
# Active Models: meta-llama/Meta-Llama-3.3-70B-Instruct, deepseek-ai/DeepSeek-R1
# Limitations: Requires billing card after initial free credits are exhausted.
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
DEEPINFRA_API_KEY=
DEEPINFRA_MODEL=meta-llama/Meta-Llama-3.3-70B-Instruct

# ── [J] Together AI (Fast Enterprise Serverless Inference) ───────────────────
# Portal: https://www.together.ai/ ($5.00 free credits on signup)
# Active Models: meta-llama/Llama-3.3-70B-Instruct-Turbo, deepseek-ai/DeepSeek-R1
# Limitations: Paid pay-as-you-go after developer credit exhaustion.
TOGETHER_BASE_URL=https://api.together.xyz/v1
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# ── [K] Cloudflare Workers AI (Serverless Edge Inference) ────────────────────
# Portal: https://dash.cloudflare.com/ (10,000 free neurons daily)
# Active Models: @cf/meta/llama-3.3-70b-instruct, @cf/deepseek-ai/deepseek-r1-distill-qwen-32b
# Limitations: Max context window typically 4k-8k tokens on Workers AI; best for fast sentiment extraction.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct

# ── [L] PRODUCTION UPGRADES (Paid / Institutional Monetization Tier) ──────────
# Uncomment and configure when deploying to production with paid subscriptions:
#
# Anthropic Claude (Flagship Institutional Synthesis)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-7-sonnet
#
# OpenAI GPT & Reasoning (State of the Art)
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4o
#
# Perplexity AI (Live NSE/BSE Financial News & Regulatory Intelligence)
# PERPLEXITY_API_KEY=pplx-...

# ── [M] Ollama (Local Offline Models) ─────────────────────────────────────────
# Run locally: ollama pull llama3.3 && ollama pull deepseek-r1
# Models: llama3.3, deepseek-r1, qwen2.5
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.3


# ==============================================================================
# 3. TRADING MODE & RISK MANAGEMENT
# ==============================================================================
# Trading mode: PAPER or LIVE
TRADING_MODE=PAPER

# Default maximum risk per trade as % of total capital (e.g. 2 = 2%)
DEFAULT_RISK_PCT=2

# Total trading capital in INR
TOTAL_CAPITAL=200000


# ==============================================================================
# 4. BROKER INTEGRATIONS (Configure on need basis)
# ==============================================================================
# Zerodha Kite Connect (https://developers.kite.trade/)
KITE_API_KEY=
KITE_API_SECRET=

# Groww Partner API
GROWW_CLIENT_ID=
GROWW_CLIENT_SECRET=
GROWW_REDIRECT_URL=http://localhost:8765/groww/callback

# Fyers API (https://myapi.fyers.in)
FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URL=http://127.0.0.1:8765/fyers/callback

# Angel One SmartAPI (https://smartapi.angelbroking.com/)
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# Upstox API (https://upstox.com/developer/api-documentation/)
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URL=http://127.0.0.1:8765/upstox/callback

# Stoxkart API (SMC Global Securities — Free API)
STOXKART_API_KEY=
STOXKART_API_SECRET=
STOXKART_CLIENT_CODE=
STOXKART_PASSWORD=
STOXKART_TOTP_SECRET=

# Shoonya / Finvasia Noren API (optional; keep blank until your account is active)
# Generate the API key/vendor code from the Shoonya Prism developer portal.
SHOONYA_USER_ID=
SHOONYA_PASSWORD=
SHOONYA_API_KEY=
SHOONYA_VENDOR_CODE=
SHOONYA_TOTP_SECRET=
SHOONYA_IMEI=chanakya-trade
SHOONYA_API_URL=https://api.shoonya.com/NorenWClientTP/
SHOONYA_WS_URL=wss://api.shoonya.com/NorenWSTP/
SHOONYA_LOGIN_URL=https://prism.shoonya.com/

# m.Stock API (Mirae Asset Capital Markets — Free API: https://trade.mstock.com)
MSTOCK_API_KEY=
MSTOCK_API_SECRET=
MSTOCK_CLIENT_CODE=
MSTOCK_PASSWORD=
MSTOCK_TOTP_SECRET=
MSTOCK_REDIRECT_URL=http://103.149.127.88:8765/mstock/callback


# ==============================================================================
# 5. OPTIONAL NOTIFICATIONS & NEWS DATA
# ==============================================================================
# NewsAPI (https://newsapi.org/)
NEWSAPI_ENABLED=0
NEWSAPI_KEY=

# Telegram Bot Alerts (@BotFather on Telegram)
TELEGRAM_BOT_TOKEN=


# ==============================================================================
# 6. WEB SEARCH PROVIDERS (AI Real-time Research & Catalysts)
# ==============================================================================
# Tavily AI Research Search (https://tavily.com - 1,000 free searches/mo)
TAVILY_API_KEY=

# Exa Neural Search (https://exa.ai - 1,000 free searches/mo)
EXA_API_KEY=

# Perplexity Search (https://www.perplexity.ai/)
PERPLEXITY_API_KEY=
# Personal / small-pilot safety profile.  Keep the defaults until paper results
# and independent broker reconciliation are consistently clean.
PILOT_PROFILE=OBSERVE
PILOT_ALLOW_LIVE_EXECUTION=0
PILOT_ALLOWED_SEGMENTS=EQUITY_DELIVERY
PILOT_ALLOWED_PRODUCTS=CNC
PILOT_MAX_ORDER_NOTIONAL=5000
# Local raw-tick archive is bounded to 7–30 days; EOD snapshots remain long-term.
RAW_TICK_RETENTION_DAYS=14
# Flag (never auto-reject) a stream price move larger than this vs prior event.
MARKET_DATA_JUMP_PCT=10
